# Eligius release signing — LOCAL template (Phase 8.4, H-1).
#
# Copy this file to the repo ROOT as `keystore.properties` and fill in the
# values, then build with:  gradle :app:assembleRelease
#
#   - `keystore.properties` is GIT-IGNORED (.gitignore) — NEVER commit it.
#   - `storeFile` is resolved relative to the repo ROOT (absolute paths work).
#   - CI instead uses GitHub Secrets (KEYSTORE_BASE64 / KEYSTORE_PASSWORD /
#     KEY_ALIAS / KEY_PASSWORD) — see .github/workflows/main.yml.
#   - The values below are PLACEHOLDERS, not real credentials.
#
# Environment variables (KEYSTORE_FILE / KEYSTORE_PASSWORD / KEY_ALIAS /
# KEY_PASSWORD) also work and take effect when keystore.properties is absent;
# keystore.properties values win per-property when both are present.

storeFile=release.jks
storePassword=REPLACE_ME
keyAlias=REPLACE_ME
keyPassword=REPLACE_ME
